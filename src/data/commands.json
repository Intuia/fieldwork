      },
      {
        "label": "Discover virtual hosts",
        "command": "ffuf -u {{url}} -H \"Host: FUZZ.{{domain}}\" -w {{wordlist}} -ac"
      },
      {
        "label": "Save JSON",
        "command": "ffuf -u {{url}}/FUZZ -w {{wordlist}} -of json -o ffuf.json"
