[
  {
    "tool": "nmap",
    "description": "Host discovery, port scanning, and service enumeration.",
    "commands": [
      {
        "label": "Full TCP scan",
        "command": "nmap -p- -sV -sC -T4 {{target}} -oA scan"
      },
      {
        "label": "Host discovery",
        "command": "nmap -sn {{target}}"
      },
      {
        "label": "Selected port",
        "command": "nmap -sV -p {{port}} {{target}}"
      },
      {
        "label": "Common UDP services",
        "command": "nmap -sU --top-ports 20 {{target}}",
        "notes": "UDP scanning generally requires elevated privileges."
      },
      {
        "label": "DNS enumeration",
        "command": "nmap -p 53 --script dns-brute --script-args dns-brute.domain={{domain}} {{target}}"
      }
    ],
    "sources": [
      "https://nmap.org/book/man.html"
    ]
  },
  {
    "tool": "subfinder",
    "description": "Passive subdomain discovery.",
    "commands": [
      {
        "label": "Passive enumeration",
        "command": "subfinder -d {{domain}}"
      },
      {
        "label": "All sources",
        "command": "subfinder -d {{domain}} -all -silent"
      },
      {
        "label": "Domain list",
        "command": "subfinder -dL {{file}} -o subdomains.txt"
      },
      {
        "label": "JSON lines",
        "command": "subfinder -d {{domain}} -oJ -o subdomains.jsonl"
      }
    ],
    "sources": [
      "https://github.com/projectdiscovery/subfinder"
    ]
  },
  {
    "tool": "amass",
    "description": "Attack-surface discovery and DNS mapping.",
    "commands": [
      {
        "label": "Enumerate domain",
        "command": "amass enum -d {{domain}}",
